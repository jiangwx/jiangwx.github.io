---
layout: default
---
{% if page._styles %}
  <!-- Page/Post style -->
  <style type="text/css">
    {{ page._styles }}
  </style>
{% endif %}

<div class="post">
  <header class="post-header">
    <h1 class="post-title">
      {% include localized_text.liquid zh=page.title_zh en=page.title_en fallback=page.title %}
    </h1>
    {% if page.description or page.description_zh or page.description_en %}
      <p class="post-description">
        {% include localized_text.liquid zh=page.description_zh en=page.description_en fallback=page.description %}
      </p>
    {% endif %}
  </header>

  <article>
    {{ content }}
  </article>

  {% if page.related_publications %}
    <h2>References</h2>
    <div class="publications">
      {% bibliography --cited_in_order %}
    </div>
  {% endif %}

  {% if site.giscus and page.giscus_comments %}
    {% include giscus.liquid %}
  {% endif %}
</div>
